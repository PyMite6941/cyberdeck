// cyberdeck fastfetch config — installed to /opt/cyberdeck/fastfetch.jsonc.
// Used by the login greeting in bashrc-cyberdeck.sh. Kept to widely-supported
// options so it works across fastfetch versions in the Pi OS repo.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": { "1": "green" }
  },
  "display": {
    "separator": " ▶ ",
    "color": { "keys": "green", "title": "cyan" }
  },
  "modules": [
    "os",
    "kernel",
    "uptime",
    { "type": "cpu", "temp": true },
    "memory",
    "swap",
    "disk",
    "localip",
    "break",
    "colors"
  ]
}
