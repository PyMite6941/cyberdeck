#!/usr/bin/env bash
# deck-fs — the deck's file explorer, in bash.
#
# The desktop's pcmanfm only exists on the graphical image, and it's gone the
# moment you run `deck-ide` / `deck-lite`. Browsing files is core to the deck,
# so it has to work on the console with nothing installed but bash and
# coreutils — which is exactly what this is. No python, no ncurses, no deps.
#
#   deck-fs [DIR]     browse DIR (default: cwd)
#
# Keys:
#   j/k or ↑/↓   move          g/G     first / last
#   l or →/Enter open (cd into dir, or open the file)
#   h or ←       up a level    ~ /     go home / go root
#   e            $EDITOR       v       view with less
#   /            filter        .       toggle hidden files
#   c            copy path to the clipboard (or print it)
#   x            run a command with the selection as $1
#   q            quit — prints the directory you ended in, so
#                `cd "$(deck-fs)"` leaves you where you browsed to
set -uo pipefail

CUR="${1:-$PWD}"
[[ -d "$CUR" ]] || { echo "deck-fs: not a directory: $CUR" >&2; exit 1; }
CUR="$(cd "$CUR" && pwd)"

SHOW_HIDDEN=0
FILTER=""
IDX=0
declare -a ENTRIES=()

# Colours (deck palette: cyan dirs, phosphor-green executables, amber links).
if [[ -t 1 ]]; then
    C_DIR=$'\e[1;36m'; C_EXE=$'\e[1;32m'; C_LNK=$'\e[1;33m'
    C_SEL=$'\e[7m';    C_DIM=$'\e[2m';    C_HDR=$'\e[1;36m'; C_OFF=$'\e[0m'
else
    C_DIR=""; C_EXE=""; C_LNK=""; C_SEL=""; C_DIM=""; C_HDR=""; C_OFF=""
fi

die() { printf '%s\n' "$*" >&2; exit 1; }

# --- listing ----------------------------------------------------------------

build_entries() {
    ENTRIES=()
    local n
    # Read names NUL-safely so spaces/newlines in filenames can't split an entry.
    while IFS= read -r -d '' n; do
        n="${n#./}"
        [[ "$n" == "." ]] && continue
        [[ $SHOW_HIDDEN -eq 0 && "$n" == .* ]] && continue
        [[ -n "$FILTER" && "${n,,}" != *"${FILTER,,}"* ]] && continue
        ENTRIES+=("$n")
    done < <(cd "$CUR" && find . -maxdepth 1 -mindepth 1 -printf '%f\0' 2>/dev/null | sort -z)

    # Directories first, then files — each already alphabetical from sort -z.
    local -a dirs=() files=()
    for n in "${ENTRIES[@]:-}"; do
        [[ -z "$n" ]] && continue
        if [[ -d "$CUR/$n" ]]; then dirs+=("$n"); else files+=("$n"); fi
    done
    ENTRIES=("${dirs[@]:-}" "${files[@]:-}")
    # Drop the empty placeholder an all-empty expansion leaves behind.
    [[ ${#ENTRIES[@]} -eq 1 && -z "${ENTRIES[0]}" ]] && ENTRIES=()

    (( IDX >= ${#ENTRIES[@]} )) && IDX=$(( ${#ENTRIES[@]} - 1 ))
    (( IDX < 0 )) && IDX=0
}

decorate() {
    local name="$1" path="$CUR/$1"
    if   [[ -L "$path" ]]; then printf '%s%s@%s' "$C_LNK" "$name" "$C_OFF"
    elif [[ -d "$path" ]]; then printf '%s%s/%s' "$C_DIR" "$name" "$C_OFF"
    elif [[ -x "$path" ]]; then printf '%s%s*%s' "$C_EXE" "$name" "$C_OFF"
    else                        printf '%s' "$name"
    fi
}

draw() {
    local rows; rows=$(tput lines 2>/dev/null || echo 24)
    local body=$(( rows - 6 )); (( body < 3 )) && body=3
    clear
    printf '%s┌─ deck-fs ─ %s%s\n' "$C_HDR" "$CUR" "$C_OFF"
    local extra=""
    [[ -n "$FILTER" ]] && extra+=" filter:'$FILTER'"
    [[ $SHOW_HIDDEN -eq 1 ]] && extra+=" +hidden"
    printf '%s│ %d item(s)%s%s\n' "$C_DIM" "${#ENTRIES[@]}" "$extra" "$C_OFF"

    if [[ ${#ENTRIES[@]} -eq 0 ]]; then
        printf '%s│ (empty)%s\n' "$C_DIM" "$C_OFF"
    else
        # Scroll window so the cursor stays visible in long directories.
        local start=$(( IDX - body / 2 ))
        (( start < 0 )) && start=0
        local max_start=$(( ${#ENTRIES[@]} - body ))
        (( max_start < 0 )) && max_start=0
        (( start > max_start )) && start=$max_start
        local i
        for (( i = start; i < start + body && i < ${#ENTRIES[@]}; i++ )); do
            if (( i == IDX )); then
                printf '%s▶ %s%s\n' "$C_SEL" "$(decorate "${ENTRIES[$i]}")" "$C_OFF"
            else
                printf '  %s\n' "$(decorate "${ENTRIES[$i]}")"
            fi
        done
    fi

    # Status line for the selection: size + mtime, from stat.
    local sel="${ENTRIES[$IDX]:-}"
    if [[ -n "$sel" ]]; then
        local info; info="$(stat -c '%A %s bytes  %y' "$CUR/$sel" 2>/dev/null | cut -c1-70)"
        printf '%s│ %s%s\n' "$C_DIM" "$info" "$C_OFF"
    fi
    printf '%s└─ j/k move  l open  h up  e edit  v view  / filter  . hidden  c copy  x run  q quit%s\n' \
        "$C_DIM" "$C_OFF"
}

# --- actions ----------------------------------------------------------------

open_entry() {
    local sel="${ENTRIES[$IDX]:-}" path
    [[ -z "$sel" ]] && return
    path="$CUR/$sel"
    if [[ -d "$path" ]]; then
        CUR="$(cd "$path" && pwd)"; IDX=0; FILTER=""
        return
    fi
    # Files: hand text to the pager and everything else to xdg-open if there's
    # a desktop, otherwise just report the type rather than dumping binary.
    if [[ -x "$path" ]] && ask "Run '$sel'?"; then
        stty sane; clear; "$path"; pause; return
    fi
    if file -b --mime-type "$path" 2>/dev/null | grep -q '^text/'; then
        stty sane; ${PAGER:-less} "$path"
    elif [[ -n "${DISPLAY:-}" ]] && command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$path" >/dev/null 2>&1 &
    else
        stty sane; clear
        printf 'Not a text file:\n\n'; file "$path"; pause
    fi
}

ask() {
    stty sane
    printf '\n%s [y/N] ' "$1" >&2
    local a; read -r a
    [[ "$a" =~ ^[Yy]$ ]]
}

pause() { printf '\n-- any key --'; read -rsn1; }

prompt_for() {
    stty sane
    printf '\n%s' "$1" >&2
    local v; IFS= read -r v
    printf '%s' "$v"
}

copy_path() {
    local sel="${ENTRIES[$IDX]:-}" path="$CUR/${ENTRIES[$IDX]:-}"
    [[ -z "$sel" ]] && path="$CUR"
    for cb in "wl-copy" "xclip -selection clipboard" "xsel -ib"; do
        if command -v "${cb%% *}" >/dev/null 2>&1; then
            printf '%s' "$path" | $cb 2>/dev/null && return 0
        fi
    done
    stty sane; clear; printf 'No clipboard tool; path is:\n\n%s\n' "$path"; pause
}

run_with() {
    local sel="${ENTRIES[$IDX]:-}"
    local cmd; cmd="$(prompt_for "command (\$1 = ${sel:-.}): ")"
    [[ -z "$cmd" ]] && return
    stty sane; clear
    ( cd "$CUR" && bash -c "$cmd \"\$1\"" _ "$sel" )
    pause
}

# --- key loop ---------------------------------------------------------------

cleanup() { stty "$STTY_SAVE" 2>/dev/null || stty sane; printf '\e[?25h'; }
STTY_SAVE="$(stty -g 2>/dev/null || true)"
trap cleanup EXIT INT TERM

# The whole point is `cd "$(deck-fs)"`, so the UI must not go to stdout when
# stdout is captured — draw on the terminal directly and print only the final
# path on stdout.
if [[ ! -t 1 ]]; then exec 3>&1 1>/dev/tty; else exec 3>&1; fi
[[ -t 0 ]] || die "deck-fs: needs a terminal"

printf '\e[?25l'
while :; do
    build_entries
    draw
    IFS= read -rsn1 key || break
    # Escape sequences for the arrow keys arrive as ESC [ A .. D
    if [[ "$key" == $'\e' ]]; then
        read -rsn2 -t 0.05 rest || rest=""
        case "$rest" in
            "[A") key=k ;; "[B") key=j ;; "[C") key=l ;; "[D") key=h ;;
            *) key="" ;;
        esac
    fi
    case "$key" in
        j) (( IDX < ${#ENTRIES[@]} - 1 )) && (( IDX++ )) ;;
        k) (( IDX > 0 )) && (( IDX-- )) ;;
        g) IDX=0 ;;
        G) IDX=$(( ${#ENTRIES[@]} - 1 )); (( IDX < 0 )) && IDX=0 ;;
        l|"") open_entry ;;
        h) CUR="$(dirname "$CUR")"; IDX=0; FILTER="" ;;
        "~") CUR="$HOME"; IDX=0; FILTER="" ;;
        "/") FILTER="$(prompt_for "filter (empty clears): ")"; IDX=0 ;;
        ".") SHOW_HIDDEN=$(( 1 - SHOW_HIDDEN )); IDX=0 ;;
        e) sel="${ENTRIES[$IDX]:-}"; [[ -n "$sel" ]] && { stty sane; ${EDITOR:-vim} "$CUR/$sel"; } ;;
        v) sel="${ENTRIES[$IDX]:-}"; [[ -n "$sel" ]] && { stty sane; ${PAGER:-less} "$CUR/$sel"; } ;;
        c) copy_path ;;
        x) run_with ;;
        q) break ;;
    esac
done

clear
# stdout (fd 3) gets the landing directory and nothing else.
printf '%s\n' "$CUR" >&3
